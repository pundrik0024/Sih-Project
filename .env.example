# Security
SECRET_KEY=aegisguard-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Render: allow the deployed Vercel frontend to make browser API requests.
# Replace this with your actual Vercel production URL. The value must be JSON.
BACKEND_CORS_ORIGINS=["https://unishield-henna.vercel.app"]

# Database
# Local SQLite default (zero friction):
DATABASE_URL=sqlite:///./cyber_threat_platform.db
# PostgreSQL production fallback:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegisguard_soc

# Risk Scoring Weights (Must sum to 1.0)
WEIGHT_ML_ANOMALY=0.30
WEIGHT_DATA_EXFILTRATION=0.20
WEIGHT_DESTINATION_ANOMALY=0.15
WEIGHT_BEHAVIOR_DEVIATION=0.15
WEIGHT_TIME_ANOMALY=0.05
WEIGHT_DEVICE_ANOMALY=0.05
WEIGHT_HISTORICAL_RISK=0.10

# Alert Severity Thresholds
THRESHOLD_LOW_MAX=30
THRESHOLD_MEDIUM_MAX=60
THRESHOLD_HIGH_MAX=80
THRESHOLD_CRITICAL_MIN=81
